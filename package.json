{
  "name": "small-language-model-gate",
  "version": "1.0.0",
  "type": "module",
  "description": "A decoupled local-SLM pre-processing and routing layer.",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "config": "node --import tsx src/config.ts",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --passWithNoTests",
    "test:decoupling": "bash -c 'trap \"mv .src_adapters_tmp src/adapters 2>/dev/null\" EXIT; mv src/adapters .src_adapters_tmp; pnpm run build && pnpm run test'",
    "models:check": "node --import tsx src/models/check.ts",
    "ledger:smoke": "tsx src/ledger/smoke.ts",
    "llm-gate:serve": "tsx src/llm-gate/index.ts",
    "mcp-gate:stdio": "tsx src/mcp-gate/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "better-sqlite3": "^11.2.1",
    "dotenv": "^16.4.5",
    "langfuse": "^3.19.0",
    "ollama": "^0.5.8",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.1"
  },
  "optionalDependencies": {
    "re2": "^1.21.4"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.9",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.2",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
